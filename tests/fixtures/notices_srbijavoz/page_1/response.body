[{"id":39340,"date":"2026-10-09T12:36:18","date_gmt":"2026-10-09T10:36:18","guid":{"rendered":"https:\/\/www.srbvoz.rs\/?post_type=info_post&#038;p=39340"},"modified":"2026-10-09T13:08:14","modified_gmt":"2026-10-09T11:08:14","slug":"kasnjenje-voza-na-realaciji-petrovaradin-uzice","status":"publish","type":"info_post","link":"https:\/\/www.srbvoz.rs\/info_post\/kasnjenje-voza-na-realaciji-petrovaradin-uzice\/","title":{"rendered":"Ka\u0161njenje voza na realaciji Petrovaradin &#8211; U\u017eice"},"content":{"rendered":"<p>12:31 ,,Srbijavoz\u201d a.d. obave\u0161tava korisnike usluga da je dana 09.10.2026. godine do\u0161lo do ka\u0161njenja voza zbog smetnji na infrastrukturnim kapacitetima.<\/p>\n<p>Voz br.615 koji polazi iz Petrovaradina za U\u017eice u 08:54 \u010dasova, \u010dekao od 12:01 \u010dasova, ispred stanice Ra\u017eana. Pokrenut sa 29 minuta zaka\u0161njenja.<\/p>\n<p>Zahvaljujemo se putnicima na razumevanju.<\/p>\n","protected":false},"template":"","categories":[],"tags":[],"acf":[],"_links":{"self":[{"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/info_post\/39340"}],"collection":[{"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/info_post"}],"about":[{"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/types\/info_post"}],"wp:attachment":[{"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/media?parent=39340"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/categories?post=39340"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.srbvoz.rs\/wp-json\/wp\/v2\/tags?post=39340"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":39339,"date":"2026-10-09T10:38:36","date_gmt":"2026-10-09T08:38:36","guid":{"rendered":"https:\/\/www.srbvoz.rs\/?post_type=info_post&#038;p=39339"},"modified":"2026-10-09T10:38:36","modified_gmt":"2026-10-09T08:38:36","slug":"izmena-saobracaja-voza-iz-sistema-bgvoz-1726","status":"publish","type":"info_post","link":"https:\/\